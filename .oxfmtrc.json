{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false,
    "groups": ["builtin", "external", "unknown"]
  }
}
